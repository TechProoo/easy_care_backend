APP_NAME="EasyCare API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://easycare.hospital.example
FRONTEND_URLS=https://easycare.hospital.example
LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=easycare_hospital
DB_USERNAME=easycare_hospital
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Private local file root; omit to use the application default.
# PROTECTED_FILES_ROOT=
